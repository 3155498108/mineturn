+package com.matuvent.mineturn.battle;
+
+import com.mojang.brigadier.CommandDispatcher;
+import com.mojang.brigadier.arguments.IntegerArgumentType;
+import java.util.*;
+import java.util.regex.Pattern;
+import net.minecraft.commands.*;
+import net.minecraft.commands.arguments.*;
+import net.minecraft.nbt.*;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.server.MinecraftServer;
+
+/** Backports the bundled macro/return functions without changing vanilla /function. */
+final class LegacyFunctions {
+    private static final Pattern PARAMETER=Pattern.compile("\\$\\(([^)]+)\\)");
+    private static final ThreadLocal<Deque<Scope>> SCOPES=ThreadLocal.withInitial(ArrayDeque::new);
+    private static final class Budget {int commands;}
+    private static final class Scope {final Budget budget;boolean returned;Scope(Budget budget){this.budget=budget;}}
+    static int run(MinecraftServer server,ResourceLocation id,CompoundTag parameters,CommandSourceStack source) throws Exception {
+        var scopes=SCOPES.get();if(scopes.size()>=128)throw new IllegalStateException("AI function recursion limit");
+        var scope=new Scope(scopes.isEmpty()?new Budget():scopes.peek().budget);scopes.push(scope);
+        try {
+            var resource=server.getResourceManager().getResource(new ResourceLocation(id.getNamespace(),"mineturn_legacy_functions/"+id.getPath()+".mcfunction"));
+            if(resource.isEmpty())resource=server.getResourceManager().getResource(new ResourceLocation(id.getNamespace(),"functions/"+id.getPath()+".mcfunction"));
+            int result=0;
+            try(var reader=resource.orElseThrow(()->new IllegalArgumentException("Missing function "+id)).openAsReader()){
+                String line;
+                while(!scope.returned && (line=reader.readLine())!=null){
+                    line=line.trim();if(line.isEmpty() || line.startsWith("#"))continue;
+                    if(++scope.budget.commands>512)throw new IllegalStateException("AI function command limit");
+                    if(line.startsWith("$")){
+                        var matcher=PARAMETER.matcher(line.substring(1));var text=new StringBuffer();
+                        while(matcher.find()){
+                            var value=parameters.get(matcher.group(1));if(value==null)throw new IllegalArgumentException("Missing macro parameter "+matcher.group(1));
+                            matcher.appendReplacement(text,java.util.regex.Matcher.quoteReplacement(value instanceof StringTag tag?tag.getAsString():value.toString()));
+                        }matcher.appendTail(text);line=text.toString();
+                    }
+                    line=line.replaceAll("\\breturn(?=\\s)","mineturn_legacy_return").replaceAll("\\bfunction(?=\\s)","mineturn_legacy_function");
+                    result=server.getCommands().getDispatcher().execute(line,source);
+                }
+            }return result;
+        } finally {scopes.pop();if(scopes.isEmpty())SCOPES.remove();}
+    }
+    static void register(CommandDispatcher<CommandSourceStack> dispatcher){
+        dispatcher.register(Commands.literal("mineturn_legacy_return").requires(source->!SCOPES.get().isEmpty())
+            .then(Commands.literal("run").redirect(dispatcher.getRoot(),context->{SCOPES.get().peek().returned=true;return context.getSource();}))
+            .then(Commands.argument("value",IntegerArgumentType.integer()).executes(context->{SCOPES.get().peek().returned=true;return IntegerArgumentType.getInteger(context,"value");})));
+        var name=Commands.argument("name",ResourceLocationArgument.id()).executes(context->invoke(context.getSource(),ResourceLocationArgument.getId(context,"name"),new CompoundTag()));
+        name.then(Commands.argument("parameters",CompoundTagArgument.compoundTag()).executes(context->invoke(context.getSource(),ResourceLocationArgument.getId(context,"name"),CompoundTagArgument.getCompoundTag(context,"parameters"))));
+        dispatcher.register(Commands.literal("mineturn_legacy_function").requires(source->!SCOPES.get().isEmpty()).then(name));
+    }
+    private static int invoke(CommandSourceStack source,ResourceLocation id,CompoundTag parameters){
+        try{return run(source.getServer(),id,parameters,source);}catch(Exception error){throw new IllegalStateException("Legacy AI function "+id,error);}
+    }
+}
