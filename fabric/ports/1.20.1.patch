+package com.matuvent.mineturn.compat;
+import java.util.*;
+import net.minecraft.nbt.*;
+import net.minecraft.world.item.*;
+import net.minecraft.world.item.alchemy.PotionUtils;
+import net.minecraft.world.entity.EquipmentSlot;
+public final class Components {
+    @SuppressWarnings("unchecked") public static <T> T get(ItemStack stack,DataComponentType<T> key){
+        var tag=stack.getTag(); Object result=null;
+        switch(key.name()){
+            case "food"->{var f=stack.getItem().getFoodProperties();if(f!=null)result=new DataComponents.Food(f.getNutrition(),f.getSaturationModifier());}
+            case "potion"->{if(stack.getItem() instanceof PotionItem)result=new PotionContents(PotionUtils.getPotion(stack),PotionUtils.getCustomEffects(stack));}
+            case "custom_data"->{if(tag!=null)result=CustomData.of(tag);}
+            case "custom_name"->{if(stack.hasCustomHoverName())result=stack.getHoverName();}
+            case "charged"->{var list=new ArrayList<ItemStack>();if(tag!=null)for(var item:tag.getList("ChargedProjectiles",Tag.TAG_COMPOUND))list.add(ItemStack.of((CompoundTag)item));result=ChargedProjectiles.of(list);}
+            case "fireworks"->{if(tag!=null && tag.contains("Fireworks",Tag.TAG_COMPOUND))result=new DataComponents.Fireworks(tag.getCompound("Fireworks").getList("Explosions",Tag.TAG_COMPOUND));}
+            case "attributes"->{var entries=new ArrayList<ItemAttributeModifiers.Entry>();stack.getAttributeModifiers(EquipmentSlot.MAINHAND).forEach((attribute,modifier)->entries.add(new ItemAttributeModifiers.Entry(attribute,modifier,new ItemAttributeModifiers.Slot(EquipmentSlot.MAINHAND))));result=new ItemAttributeModifiers(entries);}
+            default->{if(tag!=null && tag.contains(key.name()) && key.codec()!=null)result=key.codec().parse(NbtOps.INSTANCE,tag.get(key.name())).result().orElse(null);}
+        }
+        return (T)result;
+    }
+    public static <T> T getOrDefault(ItemStack stack,DataComponentType<T> key,T fallback){T value=get(stack,key);return value==null?fallback:value;}
+    public static boolean has(ItemStack stack,DataComponentType<?> key){return get(stack,key)!=null;}
+    public static <T> void set(ItemStack stack,DataComponentType<T> key,T value){
+        if(value==null){remove(stack,key);return;}
+        switch(key.name()){
+            case "custom_data"->stack.getOrCreateTag().merge(((CustomData)value).copyTag());
+            case "custom_name"->stack.setHoverName((net.minecraft.network.chat.Component)value);
+            case "potion"->{var potion=(PotionContents)value;PotionUtils.setPotion(stack,potion.potion());PotionUtils.setCustomEffects(stack,potion.customEffects());}
+            case "charged"->{var loaded=(ChargedProjectiles)value;var list=new ListTag();for(var item:loaded.getItems())list.add(item.save(new CompoundTag()));stack.getOrCreateTag().put("ChargedProjectiles",list);CrossbowItem.setCharged(stack,!loaded.isEmpty());}
+            default->{if(key.codec()==null)throw new IllegalArgumentException("Unsupported legacy component "+key.name());stack.getOrCreateTag().put(key.name(),key.codec().encodeStart(NbtOps.INSTANCE,value).result().orElseThrow());}
+        }
+    }
+    public static void remove(ItemStack stack,DataComponentType<?> key){if(key==DataComponents.CUSTOM_NAME)stack.resetHoverName();else if(stack.getTag()!=null)stack.getTag().remove(key.name());}
+}
